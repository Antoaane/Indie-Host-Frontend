NODE_ENV=development
STRICT_EXTERNAL_CONFIG=true

BASE_URL=http://localhost
SSL_DOMAIN=localhost
SSL_EMAIL=dev@indiehost.fr
CLOUDFLARE_DNS_PROPAGATION_SECONDS=30

POSTGRES_USER=indiehost
POSTGRES_PASSWORD=indiehost_dev_password
POSTGRES_DB=indiehost_db

PORT=4000
API_PREFIX=v1
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost,http://localhost:5179

PUBLIC_LISTING_ROOT_DOMAIN=localhost
# Domaines personnalisés des hôtes : IP publique du serveur (enregistrement A) et cible CNAME
# (enregistrement A « DNS only » côté Cloudflare, ex: custom.indiehost.fr). Vides en dev.
CUSTOM_DOMAIN_TARGET_IPV4=
CUSTOM_DOMAIN_CNAME_TARGET=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
# Comptes plateforme (super admin) : emails Clerk séparés par des virgules.
SUPER_ADMIN_EMAILS=dev@indiehost.fr
SCRAPFLY_KEY=
IMAGEKIT_ENDPOINT=https://ik.imagekit.io/indiehostassets
IMAGEKIT_UPLOAD_DEFAULT_FOLDER=/indiehost/listings

VITE_DONATION_LINK=
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://api:4000
CHOKIDAR_INTERVAL=300
VITE_API_REQUEST_TIMEOUT_MS=20000
VITE_BOOKINGS_API_BASE_URL=/api/v1
VITE_BOOKINGS_PATH=/bookings
VITE_CLERK_PUBLISHABLE_KEY=
VITE_IN_DEV_UTILITIES_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_API_BASE_URL=/api/v1
VITE_STRIPE_PAYMENT_INTENT_PATH=/payments/stripe/payment-intents
VITE_STRIPE_PAYMENT_RETURN_URL=http://localhost
VITE_STRIPE_CHECKOUT_OFFLINE_MODE=false
# Webhook Stripe (optionnel) : suivi des remboursements échoués et des litiges sur les réservations.
# Les réservations sont des paiements directs sur le compte Stripe de l’hôte : leurs événements
# arrivent par une destination « Comptes connectés ». Créer DEUX destinations vers la même URL
# (Stripe Dashboard → Développeurs → Webhooks → « Ajouter une destination ») :
#   1. « Votre compte » → secret dans STRIPE_WEBHOOK_SECRET
#   2. « Comptes connectés » → secret dans STRIPE_CONNECT_WEBHOOK_SECRET
#   URL : https://indiehost.fr/api/v1/payments/stripe/webhook
#   Événements : payment_intent.succeeded, payment_intent.payment_failed, charge.refunded,
#     charge.refund.updated, refund.updated, refund.failed, charge.dispute.created, charge.dispute.updated,
#     charge.dispute.closed, charge.dispute.funds_withdrawn, charge.dispute.funds_reinstated
# puis coller ici le secret de signature (whsec_…). Vide → la route répond 503 et rien n'est suivi.
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# E-mails automatiques : voyageurs (confirmation = support durable du contrat, annulation) et hôtes
# (réservation, annulation, message, avis, litige, arrivée demain, brouillon, paiements, fin d'essai…).
# Optionnel : sans clé Brevo ni SMTP, aucun e-mail n'est envoyé (avertissement dans les logs de l'API).
# Recommandé : Brevo (gratuit jusqu'à 300 e-mails par jour, données en Europe). Domaine d'envoi authentifié :
# mail.indiehost.fr (code Brevo, DKIM brevo1/brevo2 et DMARC dans Cloudflare ; la racine sert à Google
# Workspace). Expéditeur : MAIL_FROM=IndieHost <no-reply@mail.indiehost.fr>. Clé : SMTP & API → Clés API :
# BREVO_API_KEY=xkeysib-…   (ou BREVO_API_KEY_FILE=/run/secrets/brevo_api_key ; prime sur le SMTP)
# Rappels planifiés aux hôtes (9 h – 20 h, heure de Paris) : HOST_REMINDERS_ENABLED=false pour les couper.
# Aperçu sans rien envoyer : cd backend/api && npm run host-reminders -- --dry-run
# Autre possibilité, le SMTP. Google Workspace : activer la validation en deux étapes sur le compte expéditeur, créer un
# « mot de passe d'application » (Compte Google → Sécurité → Mots de passe des applications), puis :
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=no-reply@indiehost.fr
#   SMTP_PASSWORD=<mot de passe d'application à 16 caractères>
# ou en une seule variable (prime sur les autres) : SMTP_URL=smtps://no-reply%40indiehost.fr:<mdp>@smtp.gmail.com:465
# En prod, le mot de passe peut aussi venir d'un fichier : SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# (même mécanisme que STRIPE_SECRET_KEY_FILE). MAIL_FROM doit être une adresse autorisée du compte.
# SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=IndieHost <no-reply@mail.indiehost.fr>
# MAIL_REPLY_TO=
# Aperçu des gabarits sans envoyer : cd backend/api && npx tsx src/domains/notifications/preview.cli.ts
VITE_IMAGEKIT_ENDPOINT=https://ik.imagekit.io/indiehostassets
VITE_IMAGEKIT_UPLOAD_PATH=/medias/imagekit/upload
VITE_IMAGEKIT_IMPORT_PATH=/medias/imagekit/import
VITE_PUBLIC_LISTING_ROOT_DOMAIN=localhost
VITE_SCRAPING_API_URL=/scraping
VITE_SCRAPING_PROXY_TARGET=http://scraping:8000

# Référencement des sites d'hôtes (domaines reliés et sous-domaines) : l'API sert leurs pages déjà
# remplies (titre, canonique, contenu), leur robots.txt et leur sitemap, puis une tâche horaire les
# inscrit dans la Google Search Console d'IndieHost et prévient Bing (IndexNow). Rien n'est demandé à l'hôte.
# Clé d'un compte de service Google (Google Cloud → IAM → Comptes de service → Clés → JSON), avec les API
# « Google Search Console API » et « Site Verification API » activées dans le projet. Fichier JSON tel
# quel ou encodé en base64 (base64 -w0 cle.json). Vide : pas d'inscription, le reste fonctionne.
# GOOGLE_SERVICE_ACCOUNT_KEY=
# Comptes Google ajoutés comme propriétaires de chaque site (ils le voient dans leur Search Console) :
# SEARCH_CONSOLE_OWNER_EMAILS=dev@indiehost.fr
# Tâche horaire (pré-remplissage des pages principales, certificats www, Search Console, IndexNow) :
# PUBLIC_SITES_JOB_ENABLED=true   Aperçu : cd backend/api && npm run public-sites -- --dry-run
# IndexNow (production seulement) : clé dérivée d'un secret de l'API si vide.
# INDEXNOW_ENABLED=true
# INDEXNOW_KEY=
