{
   "$schema": "https://json.schemastore.org/prettierrc",
   "semi": false,
   "singleQuote": true,
   "printWidth": 999,
   "singleAttributePerLine": true,
   "vueMaxAttributesPerLine": {
      "singleline": 1,
      "multiline": 1
   },
   "htmlWhitespaceSensitivity": "strict",
   "tabWidth": 2,
   "useTabs": false
}
