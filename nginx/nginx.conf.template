# Sites des hôtes (domaines reliés, sous-domaines d'indiehost.fr) : leurs pages passent par l'API,
# qui sert le HTML déjà rempli (titre, canonique, contenu de l'annonce), les redirections 301,
# robots.txt, sitemap.xml et les fichiers de validation (backend/api/src/domains/publicSite).
# Sur indiehost.fr, seules les adresses d'annonce (`/<nom>`) y passent, pour la redirection 301 vers
# le domaine de l'annonce. Tout le reste va au site comme avant ; voir proxy-locations.conf.
map $host $ih_main_host {
    default 0;
    ${SSL_DOMAIN} 1;
    www.${SSL_DOMAIN} 1;
}

map $uri $ih_site_path {
    default 0;
    ~^/[^.]*$ 1;
    /robots.txt 1;
    /sitemap.xml 1;
    ~^/google[0-9a-f]+\.html$ 1;
    "~^/[0-9a-zA-Z-]{8,128}\.txt$" 1;
}

map $uri $ih_main_listing_path {
    default 0;
    ~^/(?:api|assets|booking|create-listing|dashboard|dev|domains|donation|editor|legal|listing|management|messagerie|pricing|sign-in|sign-up)/?$ 0;
    ~^/[a-z0-9-]+/?$ 1;
}

map "$ih_main_host:$ih_site_path:$ih_main_listing_path" $ih_public_site {
    default 0;
    ~^0:1: 1;
    ~^1:.:1$ 1;
}

# Groupes nommés : une `location` nommée ne peut écrire l'adresse de `proxy_pass` qu'avec une
# variable, et une variable sans groupe nommé exigerait un résolveur DNS.
upstream ih_api {
    server api:4000;
}

upstream ih_frontend {
    server frontend:80;
}

# Le nom SNI sert à choisir le certificat d'un domaine personnalisé : on ne l'accepte
# dans un chemin de fichier que s'il ne contient que des caractères de nom d'hôte.
map $ssl_server_name $custom_domain_cert_name {
    ~^[a-z0-9.-]+$    $ssl_server_name;
    default           _invalid;
}

# HTTP : challenge ACME (certificats des domaines personnalisés) puis redirection HTTPS, quel que soit l'hôte.
server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 50m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SSL_DOMAIN} *.${SSL_DOMAIN};

    client_max_body_size 50m;

    ssl_certificate /etc/letsencrypt/live/${SSL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SSL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Tous les sous-domaines sont servis en HTTPS (certificat wildcard). Pas de `preload` :
    # l'inscription dans les navigateurs est quasi irréversible.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/snippets/proxy-locations.conf;
}

# Domaines personnalisés des hôtes (ex. www.gite-belair.fr) : le certificat est chargé d'après
# le SNI, les fichiers sont émis par le conteneur certbot (HTTP-01) pour chaque domaine vérifié.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    client_max_body_size 50m;

    ssl_certificate /etc/letsencrypt/live/$custom_domain_cert_name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$custom_domain_cert_name/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    include /etc/nginx/snippets/proxy-locations.conf;
}
