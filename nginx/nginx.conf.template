# Adresse réelle du visiteur derrière Cloudflare (limites par IP de l'API, logs). L'en-tête n'est
# lu que si la connexion vient d'une plage Cloudflare : un client qui contacte directement le VPS
# (domaines personnalisés) ne peut pas l'usurper. Plages : https://www.cloudflare.com/ips/
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# Le nom SNI sert à choisir le certificat d'un domaine personnalisé : on ne l'accepte
# dans un chemin de fichier que s'il ne contient que des caractères de nom d'hôte.
map $ssl_server_name $custom_domain_cert_name {
    ~^[a-z0-9.-]+$    $ssl_server_name;
    default           _invalid;
}

# HTTP : challenge ACME (certificats des domaines personnalisés) puis redirection HTTPS, quel que soit l'hôte.
server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 50m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SSL_DOMAIN} *.${SSL_DOMAIN};

    client_max_body_size 50m;

    ssl_certificate /etc/letsencrypt/live/${SSL_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SSL_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Tous les sous-domaines sont servis en HTTPS (certificat wildcard). Pas de `preload` :
    # l'inscription dans les navigateurs est quasi irréversible.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/snippets/proxy-locations.conf;
}

# Domaines personnalisés des hôtes (ex. www.gite-belair.fr) : le certificat est chargé d'après
# le SNI, les fichiers sont émis par le conteneur certbot (HTTP-01) pour chaque domaine vérifié.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    client_max_body_size 50m;

    ssl_certificate /etc/letsencrypt/live/$custom_domain_cert_name/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$custom_domain_cert_name/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    include /etc/nginx/snippets/proxy-locations.conf;
}
