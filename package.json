{
  "name": "ihf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-c": "cross-env DEVCHAT_DEV=true vite",
    "tag:files": "node ./plugins/file-path-comment/inject-comments.js",
    "svg:convert": "python ./plugins/svg-to-vue/convert_svg.py",
    "images:resize": "python ./plugins/resize_images.py",
    "watch": "sass --watch ./src/assets/styles/input.scss ./src/assets/styles/output.css",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.57.0",
    "@clerk/vue": "^1.17.0",
    "@fancyapps/ui": "^6.0.28",
    "@nuxt/ui": "^4.1.0",
    "@splidejs/vue-splide": "^0.6.12",
    "@unhead/vue": "^2.0.9",
    "@vueuse/core": "^13.3.0",
    "@vueuse/integrations": "^13.3.0",
    "axios": "^1.13.2",
    "change-case": "^5.4.4",
    "chokidar": "^4.0.3",
    "gsap": "^3.12.7",
    "keen-slider": "^6.8.6",
    "lenis": "^1.3.3",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.1",
    "prettier-plugin-multiline-arrays": "^3.0.6",
    "quill": "^2.0.3",
    "swiper": "^11.2.7",
    "vue": "^3.5.13",
    "vue-quilly": "^1.1.6",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.13.9",
    "@types/swiper": "^5.4.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.87.0",
    "svgo": "^3.0.2",
    "typescript": "~5.8.0",
    "vite": "^6.2.1",
    "vite-plugin-devchat": "file:../Vite-Plugin-Devchat",
    "vite-plugin-restart": "^0.4.2",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.2.8"
  }
}
