NODE_ENV=development
PORT=4000
API_BODY_LIMIT_BYTES=52428800
API_PREFIX=v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5179,http://localhost:3000

DATABASE_URL=postgresql://indiehost:indiehost_dev_password@127.0.0.1:5432/indiehost_db?schema=public
IMAGEKIT_API_KEY=private_xxx
IMAGEKIT_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_UPLOAD_DEFAULT_FOLDER=/indiehost/listings

CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain
CLERK_AUDIENCE=

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_PLATFORM_FEE_BPS=0
STRIPE_CONNECT_DEFAULT_APPLICATION_FEE_BPS=0
STRIPE_BILLING_PRICE_INDIEHOST=price_xxx
STRIPE_BILLING_PRICE_SUPERHOST=price_xxx
STRIPE_BILLING_PRICE_MEGAHOST=price_xxx

ICAL_EXPORT_DEFAULT_PRODID=IndieHost//Calendar//FR
PUBLIC_LISTING_ROOT_DOMAIN=indiehost.fr

GRANDI_API_TOKEN=your-gandi-api-key
GRANDI_API_BASE_URL=https://api.gandi.net/v5
GRANDI_CHECKOUT_BASE_URL=https://www.gandi.net/en/domain/checkout
