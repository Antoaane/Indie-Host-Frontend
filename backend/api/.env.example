# Legacy non-docker mode only.
# In Docker mode, API runtime vars come from root /.env + secrets files.

NODE_ENV=development
PORT=4000
API_PREFIX=v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5179,http://localhost:3000

DATABASE_URL=postgresql://user:password@IP/db_name?schema=public
IMAGEKIT_API_KEY=private_...
IMAGEKIT_ENDPOINT=https://ik.imagekit.io/indiehostassets
IMAGEKIT_UPLOAD_DEFAULT_FOLDER=/indiehost/listings

CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=sk_...

STRIPE_SECRET_KEY=sk_...
STRIPE_CONNECT_PLATFORM_FEE_BPS=0
STRIPE_CONNECT_DEFAULT_APPLICATION_FEE_BPS=0

ICAL_EXPORT_DEFAULT_PRODID=IndieHost//Calendar//FR
ICAL_SYNC_THROTTLE_SECONDS=300
ICAL_SYNC_FETCH_TIMEOUT_MS=15000
PUBLIC_LISTING_ROOT_DOMAIN=indiehost.fr

# Docker secrets fallback (optional)
# If a *_FILE variable is set, API will read the value from that file when the direct variable is empty.
# DATABASE_URL_FILE=/run/secrets/database_url
# IMAGEKIT_API_KEY_FILE=/run/secrets/imagekit_api_key
# CLERK_SECRET_KEY_FILE=/run/secrets/clerk_secret_key
# STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
