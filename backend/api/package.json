{
  "name": "@indiehost/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IndieHost Fastify API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:docker": "sh ./scripts/docker-run-with-database-url.sh node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:docker": "sh ./scripts/docker-run-with-database-url.sh prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "stripe:billing:setup:dev": "node scripts/ensure-stripe-billing-plans.mjs",
    "purge": "tsx src/jobs/retention.cli.ts",
    "purge:prod": "node dist/jobs/retention.cli.js",
    "host-reminders": "tsx src/jobs/hostReminders.cli.ts",
    "public-sites": "tsx src/jobs/publicSites.cli.ts",
    "calendar-sync": "tsx src/jobs/calendarSync.cli.ts",
    "group-payments": "tsx src/jobs/groupPayments.cli.ts",
    "connect-audit": "tsx src/domains/payments/connectAudit.cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/sensible": "^6.0.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/sanitize-html": "^2.16.2",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.2.2",
    "fastify-plugin": "^6.0.1",
    "ical-generator": "^11.1.4",
    "jose": "^6.2.18",
    "node-ical": "^0.27.6",
    "nodemailer": "^10.6.1",
    "sanitize-html": "^2.18.2",
    "stripe": "^17.7.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
