{
  "name": "ihf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-c": "cross-env DEVCHAT_DEV=true vite",
    "tag:files": "node ./plugins/file-path-comment/inject-comments.js",
    "svg:convert": "python ./plugins/svg-to-vue/convert_svg.py",
    "images:resize": "python ./plugins/resize_images.py",
    "watch": "sass --watch ./src/assets/styles/input.scss ./src/assets/styles/output.css",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@clerk/vue": "^2.5.26",
    "@fancyapps/ui": "^6.0.28",
    "@lucide/vue": "^1.77.0",
    "@nuxt/ui": "^4.1.0",
    "@splidejs/vue-splide": "^0.6.12",
    "@stripe/stripe-js": "^10.3.0",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.13.2",
    "canvas-confetti": "^1.9.4",
    "change-case": "^5.4.4",
    "dompurify": "^3.4.17",
    "gsap": "^3.12.7",
    "keen-slider": "^6.8.6",
    "lenis": "^1.3.3",
    "maplibre-gl": "6.19.0",
    "pinia": "^4.1.0",
    "quill": "2.0.2",
    "swiper": "^14.4.0",
    "vue": "^3.5.13",
    "vue-quilly": "^1.1.2",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.5.3",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "sass-embedded": "^1.87.0",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-devchat": "file:../Vite-Plugin-Devchat",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  }
}
