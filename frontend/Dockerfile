FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_DONATION_LINK=
ARG VITE_LISTINGS_DATA_MODE=api
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_API_REQUEST_TIMEOUT_MS=20000
ARG VITE_CLERK_PUBLISHABLE_KEY=
ARG VITE_IN_DEV_UTILITIES_ENABLED=false
ARG VITE_STRIPE_PUBLISHABLE_KEY=
ARG VITE_STRIPE_API_BASE_URL=/api/v1
ARG VITE_STRIPE_PAYMENT_INTENT_PATH=/payments/stripe/payment-intents
ARG VITE_STRIPE_PAYMENT_RETURN_URL=http://localhost
ARG VITE_STRIPE_CHECKOUT_OFFLINE_MODE=false
ARG VITE_IMAGEKIT_ENDPOINT=
ARG VITE_PUBLIC_LISTING_ROOT_DOMAIN=localhost

ENV VITE_DONATION_LINK=$VITE_DONATION_LINK
ENV VITE_LISTINGS_DATA_MODE=$VITE_LISTINGS_DATA_MODE
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_REQUEST_TIMEOUT_MS=$VITE_API_REQUEST_TIMEOUT_MS
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_IN_DEV_UTILITIES_ENABLED=$VITE_IN_DEV_UTILITIES_ENABLED
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_STRIPE_API_BASE_URL=$VITE_STRIPE_API_BASE_URL
ENV VITE_STRIPE_PAYMENT_INTENT_PATH=$VITE_STRIPE_PAYMENT_INTENT_PATH
ENV VITE_STRIPE_PAYMENT_RETURN_URL=$VITE_STRIPE_PAYMENT_RETURN_URL
ENV VITE_STRIPE_CHECKOUT_OFFLINE_MODE=$VITE_STRIPE_CHECKOUT_OFFLINE_MODE
ENV VITE_IMAGEKIT_ENDPOINT=$VITE_IMAGEKIT_ENDPOINT
ENV VITE_PUBLIC_LISTING_ROOT_DOMAIN=$VITE_PUBLIC_LISTING_ROOT_DOMAIN

RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
