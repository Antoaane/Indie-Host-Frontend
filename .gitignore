############################
# Racine Indie-Host-Frontend
############################

# Fichiers macOS
.DS_Store
.ds_store

# Environnements virtuels Python (scraper)
backend/microservices/microservice-scraping-py/.venv/
backend/microservices/microservice-scraping-py/venv/

# Fichiers Python générés
backend/microservices/microservice-scraping-py/**/*.pyc
backend/microservices/microservice-scraping-py/**/__pycache__/

# Fichiers de sortie du scraper (non versionnés)
backend/microservices/microservice-scraping-py/annonce.json

# Config locale / secrets éventuels
backend/microservices/microservice-scraping-py/.env

# Fichiers Node à ne pas sur-pister localement
frontend/package-lock.json
frontend/package.json

############################
# Backend CMS (Next.js / Payload)
############################

# Dépendances
backend/cms/node_modules/

# Build Next.js
backend/cms/.next/
backend/cms/out/

# Cache & outils
backend/cms/.turbo
backend/cms/.vercel
backend/cms/.swc/

# Environnement / secrets
backend/cms/.env
backend/cms/.env.local
backend/cms/.env.*.local

# Logs et debug
backend/cms/npm-debug.log*
backend/cms/yarn-debug.log*
backend/cms/yarn-error.log*
backend/cms/.pnpm-debug.log*

############################
# Backend API NestJS
############################

backend/api/node_modules/
backend/api/dist/
backend/api/.env

/secrets
/secret.test

/.env
/.env.*
!/.env.example

# Secrets prod (copies vers le VPS, jamais commites)
/secrets.production

# Certbot runtime (certificats, cle privee, compte ACME) — jamais commites
/certbot/conf/accounts
/certbot/conf/archive
/certbot/conf/live
/certbot/conf/renewal
/certbot/conf/csr
/certbot/conf/keys
/certbot/www

############################
# Skills Claude Code (.claude/skills)
############################

# Binaire moteur impeccable : ~16 Mo, specifique a l'OS/arch, retelecharge
# automatiquement par le launcher au premier `impeccable context`
/.claude/skills/impeccable/scripts/bin/

# Etat local impeccable propre a chaque developpeur
/.impeccable/config.local.json
