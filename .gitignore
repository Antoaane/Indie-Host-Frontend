############################
# Racine Indie-Host-Frontend
############################

# Environnements virtuels Python (scraper)
IndieHost-Scraping/.venv/
IndieHost-Scraping/venv/

# Fichiers Python générés
IndieHost-Scraping/**/*.pyc
IndieHost-Scraping/**/__pycache__/

# Fichiers de sortie du scraper (non versionnés)
IndieHost-Scraping/annonce.json

# Config locale / secrets éventuels
IndieHost-Scraping/.env

# Fichiers Node à ne pas sur-pister localement
frontend/package-lock.json
frontend/package.json

############################
# Backend CMS (Next.js / Payload)
############################

# Dépendances
backend/cms/node_modules/

# Build Next.js
backend/cms/.next/
backend/cms/out/

# Cache & outils
backend/cms/.turbo
backend/cms/.vercel
backend/cms/.swc/

# Environnement / secrets
backend/cms/.env
backend/cms/.env.local
backend/cms/.env.*.local

# Logs et debug
backend/cms/npm-debug.log*
backend/cms/yarn-debug.log*
backend/cms/yarn-error.log*
backend/cms/.pnpm-debug.log*

############################
# Backend API NestJS
############################

backend/api/node_modules/
backend/api/dist/
backend/api/.env

/secrets
/secret.test

/.env
/.env.*
!/.env.example

